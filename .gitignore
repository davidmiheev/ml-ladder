# Run outputs and datasets — regenerate, never commit.
# Anchored to the repo root: an unanchored "data/" also swallows
# docs/writeups/data/, which is committed on purpose.
/artifacts/
/data/
wandb/
*.ckpt
*.pt
*.pth
*.npz

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# Intermediate LaTeX from tools/build_pdf.py --keep
docs/writeups/pdf/*.tex

# Rust
/rust/target/

# Editors / OS
.DS_Store
.idea/
.vscode/
